{
  "name": "ischool-b2b-workshop-game",
  "version": "1.0.0",
  "description": "Real-time interactive onboarding workshop game platform for iSchool B2B coding instructors",
  "scripts": {
    "dev": "concurrently --names \"SERVER,CLIENT\" --prefix-colors \"cyan,magenta\" \"npm run server:dev\" \"npm run client:dev\"",
    "start": "concurrently --names \"SERVER,CLIENT\" --prefix-colors \"cyan,magenta\" \"npm run server\" \"npm run client:preview\"",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "client:preview": "npm --prefix client run preview",
    "build": "npm --prefix client run build",
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install:all": "npm run install:server && npm run install:client",
    "setup": "npm install && npm run install:all",
    "kill:ports": "node -e \"const {execSync}=require('child_process');['3001','5173'].forEach(p=>{try{const pid=execSync('netstat -ano 2>nul | findstr :'+p+' | findstr LISTENING',{encoding:'utf8'}).trim().split(/\\s+/).pop();if(pid)execSync('taskkill /PID '+pid+' /F',{stdio:'inherit'});}catch(e){}});console.log('Ports cleared');\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
